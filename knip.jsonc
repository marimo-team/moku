{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    "apps/@moku-launcher": {
      // Both launcher stylesheets import the font through CSS.
      "ignoreDependencies": ["@fontsource-variable/inter"],
    },
    "packages/@moku-outputs": {
      // scripts/build.ts passes this entry to Vite's programmatic build.
      "entry": ["bundle/renderer.tsx"],
      // The renderer resolves @/ imports and jotai from the selected marimo frontend.
      "ignoreUnresolved": ["^@/"],
      // The build script loads the copy of vite provided by vite-plus.
      "ignoreDependencies": ["jotai", "vite"],
    },
  },
}
