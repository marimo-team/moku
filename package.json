{
  "name": "moku",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/@moku-launcher --silent dev",
    "build": "bun run --cwd apps/@moku-launcher --silent build",
    "preview": "bun run --cwd apps/@moku-launcher --silent preview",
    "check": "vp check",
    "format": "vp fmt",
    "test": "vp test run",
    "setup": "bun scripts/setup.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4"
