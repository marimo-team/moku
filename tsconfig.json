{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "vite-plus/client"]
  },
  "include": ["apps", "packages", "vite.config.ts"],
  "exclude": ["packages/@moku-outputs/bundle"]
}
